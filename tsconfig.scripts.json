{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": ".ts-node-output",
    "rootDir": "."
  },
  "include": ["scripts/**/*.ts", "lib/**/*.ts"]
}
