# Core app
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_dev_nextauth_secret

# Database
DATABASE_URL=mysql://user:password@localhost:3306/pinkaroo_dev
SHADOW_DATABASE_URL=mysql://user:password@localhost:3306/pinkaroo_dev_shadow

# Auth providers (optional)
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GITHUB_ID=replace_with_github_client_id
GITHUB_SECRET=replace_with_github_client_secret
FACEBOOK_CLIENT_ID=replace_with_facebook_client_id
FACEBOOK_CLIENT_SECRET=replace_with_facebook_client_secret
APPLE_ID=replace_with_apple_client_id
APPLE_SECRET=replace_with_apple_client_secret

# Dev session emulation
EMULATE_SESSION_EMAIL=emulate@local
EMULATE_SESSION_PASSWORD=emulate
EMULATE_SESSION_ROLE=REALTOR

# Google Maps / Geocoding
GOOGLE_MAPS_API_KEY=replace_with_google_maps_api_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_google_maps_api_key

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# CREA / MLS
CREA_CLIENT_ID=replace_with_crea_client_id
CREA_CLIENT_SECRET=replace_with_crea_client_secret

# Cron
CRON_SECRET=replace_with_dev_cron_secret

# Email
NODEMAILER_USER=replace_with_email_user
NODEMAILER_PASS=replace_with_email_password

# Redis and rate limiting (optional for local)
REDIS_URL=redis://localhost:6379
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=20

# Public metadata
NEXT_PUBLIC_APP_NAME=Pinkaroo
SENTRY_DSN=replace_with_sentry_dsn
