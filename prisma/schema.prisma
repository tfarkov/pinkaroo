datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?   // Optional for OAuth (Google, etc.)
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  name          String?
  bio           String?
  phone         String?
  availableHours String?
  ratings       Float?    @default(0)
  listingsCount Int?      @default(0) // Denormalized for metrics
  avgSalePrice  Float?    @default(0)
  clientConversionRate Float? @default(0)
  approvalRate  Float?    @default(0)
  brokerId      String?
  teamId        String?   // Optional: realtor can be assigned to a team within the broker's org
  isTeamLead    Boolean?  @default(false) // Realtors designated as team leads can edit team profiles
  broker        User?     @relation("BrokerTeam", fields: [brokerId], references: [id])
  teamMembers   User[]    @relation("BrokerTeam")
  teams         Team[]    @relation("BrokerOwnsTeams") // Teams this user (broker) owns
  team          Team?     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  listings      Listing[]
  clients       Client[]
  interactions  Interaction[]
  notifications     Notification[]
  notificationsFrom Notification[] @relation("NotificationFrom")
  favorites         Favorite[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?  @db.Text
  id_token          String?  @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@id([identifier, token])
}
enum Role {
  USER
  ADMIN
  REALTOR
  BROKER
}
model Listing {
  id                 String       @id @default(uuid())
  title              String
  description        String
  price              Float
  location           String
  province           Province     @default(ONTARIO)
  postalCode         String?
  sizeSqm            Float?
  bedroomsTotal      Int?
  bathroomsTotal     Int?
  propertyType       String?
  latitude           Float?
  longitude          Float?
  images             Json?   // array of image URLs
  mlsId              String?  @unique
  status             ListingStatus @default(ACTIVE)
  approvedBy         String?
  approvedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  favorites          Favorite[]
  // MLS / DDF property attributes
  streetAddress      String?
  unitNumber         String?
  yearBuilt          Int?
  lotSizeSqm         Float?
  standardStatus     String?   // e.g. Active, Sold
  halfBathroomsTotal Int?
  buildingLevelTotal Int?      // stories
  mlsLastUpdated     DateTime?
  mlsData            Json?     // full raw MLS payload for extra attributes
  // Eco-rating: precomputed 1–10 score, indexed for sorting
  ecoRatingScore     Float?
  heatingType        String?
  insulationQuality  String?
  hasRecentRenovations Boolean?
  roofAgeYears       Int?
  appliancesAgeYears Int?
  @@index([status])
  @@index([userId])
  @@index([latitude, longitude])
  @@index([ecoRatingScore])
}
enum ListingStatus {
  ACTIVE
  PENDING
  APPROVED
  REJECTED
}
enum Province {
  ALBERTA
  BRITISH_COLUMBIA
  MANITOBA
  NEW_BRUNSWICK
  NEWFOUNDLAND_AND_LABRADOR
  NOVA_SCOTIA
  ONTARIO
  PRINCE_EDWARD_ISLAND
  QUEBEC
  SASKATCHEWAN
  NORTHWEST_TERRITORIES
  NUNAVUT
  YUKON
}
model Client {
  id            String       @id @default(uuid())
  name          String
  email         String?
  phone         String?
  notes         String?
  status        ClientStatus @default(LEAD) 
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  userId        String       
  user          User         @relation(fields: [userId], references: [id])
  interactions  Interaction[]
  @@index([status])
  @@index([userId])
}
enum ClientStatus {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED
}
model Interaction {
  id        String   @id @default(uuid())
  type      String   
  details   String
  date      DateTime
  clientId  String
  userId    String   
  client    Client   @relation(fields: [clientId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([clientId, date])
}
model Notification {
  id         String    @id @default(uuid())
  message    String
  type       NotificationType
  read       Boolean   @default(false)
  replyText  String?
  repliedAt  DateTime?
  flagged    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  fromUserId String?
  fromUser   User?     @relation("NotificationFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
}
enum NotificationType {
  APPROVAL
  INTERACTION
  SYSTEM
  MESSAGE
}
model Team {
  id        String   @id @default(uuid())
  name      String
  brokerId  String
  broker    User     @relation("BrokerOwnsTeams", fields: [brokerId], references: [id], onDelete: Cascade)
  members   User[]   @relation("TeamMembers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([brokerId])
}
model Config {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String?
  updatedAt  DateTime @updatedAt
}
model Favorite {
  id        String   @id @default(uuid())
  listingId String
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@unique([userId, listingId])
}
