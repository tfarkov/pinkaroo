datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?   // Optional for OAuth (Google, etc.)
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  name          String?
  bio           String?
  phone         String?
  availableHours String?
  ratings       Float?    @default(0)
  listingsCount Int?      @default(0) // Denormalized for metrics
  avgSalePrice  Float?    @default(0)
  clientConversionRate Float? @default(0)
  approvalRate  Float?    @default(0)
  brokerId      String?
  teamId        String?   // Optional: realtor can be assigned to a team within the broker's org
  isTeamLead    Boolean?  @default(false) // Realtors designated as team leads can edit team profiles
  broker        User?     @relation("BrokerTeam", fields: [brokerId], references: [id])
  teamMembers   User[]    @relation("BrokerTeam")
  teams         Team[]    @relation("BrokerOwnsTeams") // Teams this user (broker) owns
  team          Team?     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  brokerClients Client[]  @relation("BrokerClients")
  brokerAssignments WorkloadAssignment[] @relation("BrokerAssignments")
  realtorAssignments WorkloadAssignment[] @relation("RealtorAssignments")
  assignedTasks WorkloadAssignment[] @relation("AssignedByUser")
  brokerTemplates CommsTemplate[] @relation("BrokerCommsTemplates")
  brokerBroadcasts BrokerBroadcast[] @relation("BrokerBroadcasts")
  sentBroadcasts BrokerBroadcast[] @relation("BroadcastSender")
  auditLogsAsActor AuditLog[] @relation("AuditActor")
  auditLogsAsBroker AuditLog[] @relation("AuditBroker")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  listings      Listing[]
  clients       Client[]
  interactions  Interaction[]
  notifications     Notification[]
  notificationsFrom Notification[] @relation("NotificationFrom")
  favorites         Favorite[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?  @db.Text
  id_token          String?  @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@id([identifier, token])
}
enum Role {
  USER
  OFFICE_ADMIN
  SYSTEM_ADMIN
  REALTOR
  BROKER
}
model Listing {
  id                 String       @id @default(uuid())
  title              String
  description        String
  price              Float
  location           String
  province           Province     @default(ONTARIO)
  postalCode         String?
  sizeSqm            Float?
  bedroomsTotal      Int?
  bathroomsTotal     Int?
  propertyType       String?
  latitude           Float?
  longitude          Float?
  images             Json?   // array of image URLs
  mlsId              String?  @unique
  status             ListingStatus @default(ACTIVE)
  approvedBy         String?
  approvedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  favorites          Favorite[]
  assignments        WorkloadAssignment[]
  // MLS / DDF property attributes
  streetAddress      String?
  unitNumber         String?
  yearBuilt          Int?
  lotSizeSqm         Float?
  standardStatus     String?   // e.g. Active, Sold
  halfBathroomsTotal Int?
  buildingLevelTotal Int?      // stories
  mlsLastUpdated     DateTime?
  mlsData            Json?     // full raw MLS payload for extra attributes
  // Eco-rating: precomputed 1–10 score, indexed for sorting
  ecoRatingScore     Float?
  heatingType        String?
  insulationQuality  String?
  hasRecentRenovations Boolean?
  roofAgeYears       Int?
  appliancesAgeYears Int?
  @@index([status])
  @@index([userId])
  @@index([latitude, longitude])
  @@index([ecoRatingScore])
}
enum ListingStatus {
  ACTIVE
  PENDING
  APPROVED
  REJECTED
}
enum Province {
  ALBERTA
  BRITISH_COLUMBIA
  MANITOBA
  NEW_BRUNSWICK
  NEWFOUNDLAND_AND_LABRADOR
  NOVA_SCOTIA
  ONTARIO
  PRINCE_EDWARD_ISLAND
  QUEBEC
  SASKATCHEWAN
  NORTHWEST_TERRITORIES
  NUNAVUT
  YUKON
}
model Client {
  id            String       @id @default(uuid())
  name          String
  email         String?
  phone         String?
  notes         String?
  status        ClientStatus @default(LEAD) 
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  userId        String       
  user          User         @relation(fields: [userId], references: [id])
  brokerId      String?
  broker        User?        @relation("BrokerClients", fields: [brokerId], references: [id], onDelete: SetNull)
  teamId        String?
  team          Team?        @relation("TeamClients", fields: [teamId], references: [id], onDelete: SetNull)
  assignments   WorkloadAssignment[]
  interactions  Interaction[]
  @@index([status])
  @@index([userId])
  @@index([brokerId])
  @@index([teamId])
}
enum ClientStatus {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED
}
model Interaction {
  id        String   @id @default(uuid())
  type      String   
  details   String
  date      DateTime
  clientId  String
  userId    String   
  client    Client   @relation(fields: [clientId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([clientId, date])
}
model Notification {
  id         String    @id @default(uuid())
  message    String
  type       NotificationType
  read       Boolean   @default(false)
  replyText  String?
  repliedAt  DateTime?
  flagged    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  fromUserId String?
  fromUser   User?     @relation("NotificationFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
}
enum NotificationType {
  APPROVAL
  INTERACTION
  SYSTEM
  MESSAGE
}
model Team {
  id        String   @id @default(uuid())
  name      String
  brokerId  String
  targetListings Int?   @default(0)
  targetRevenue  Float? @default(0)
  targetInteractions Int? @default(0)
  broker    User     @relation("BrokerOwnsTeams", fields: [brokerId], references: [id], onDelete: Cascade)
  members   User[]   @relation("TeamMembers")
  clients   Client[] @relation("TeamClients")
  broadcasts BrokerBroadcast[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([brokerId])
}
model Config {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String?  @db.Text
  updatedAt  DateTime @updatedAt
}
model Favorite {
  id        String   @id @default(uuid())
  listingId String
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@unique([userId, listingId])
}

model WorkloadAssignment {
  id          String           @id @default(uuid())
  title       String
  details     String?
  priority    Int              @default(3)
  status      AssignmentStatus @default(OPEN)
  dueAt       DateTime?
  brokerId    String
  broker      User             @relation("BrokerAssignments", fields: [brokerId], references: [id], onDelete: Cascade)
  realtorId   String
  realtor     User             @relation("RealtorAssignments", fields: [realtorId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy  User?            @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  listingId   String?
  listing     Listing?         @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@index([brokerId, status])
  @@index([realtorId, status])
  @@index([dueAt])
}

enum AssignmentStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
}

model CommsTemplate {
  id        String   @id @default(uuid())
  brokerId  String
  broker    User     @relation("BrokerCommsTemplates", fields: [brokerId], references: [id], onDelete: Cascade)
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  broadcasts BrokerBroadcast[]
  @@index([brokerId])
}

model BrokerBroadcast {
  id         String   @id @default(uuid())
  brokerId   String
  broker     User     @relation("BrokerBroadcasts", fields: [brokerId], references: [id], onDelete: Cascade)
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  templateId String?
  template   CommsTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sentById   String
  sentBy     User     @relation("BroadcastSender", fields: [sentById], references: [id], onDelete: Cascade)
  subject    String
  message    String
  createdAt  DateTime @default(now())
  @@index([brokerId, createdAt])
  @@index([teamId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  brokerId  String?
  broker    User?    @relation("AuditBroker", fields: [brokerId], references: [id], onDelete: SetNull)
  action    String
  entityType String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
  @@index([brokerId, createdAt])
  @@index([actorId, createdAt])
}
